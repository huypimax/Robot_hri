<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    x:Class="RobotHri.Views.QnaPage"
    x:DataType="vm:QnaViewModel"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="Auto,*">
        <c:NavRail Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*,Auto,Auto"
              Padding="12,8,12,10">

            <Image Grid.RowSpan="3"
               Source="lotus_bg.png"
               Aspect="AspectFill"
               Opacity="0.3"
               InputTransparent="True" />

            <Image Grid.Row="0"
               Source="lotus_banner.png"
               HeightRequest="78"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Start"
               Margin="0,0,0,6"
               InputTransparent="True" />

            <Border Grid.Row="0"
            BackgroundColor="{StaticResource NavGlassDark}"
            StrokeThickness="0"
            Margin="0,0,0,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <c:HeaderLayout x:Name="Header"
                    Title="{Binding TitleText}"
                    BackText="{Binding HomeText}"
                    ShowBackButton="True"
                    LanguageLabelText="{Binding LanguageLabel}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
            </Border>

            <!-- Robot avatar + Response area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="18"
                                 Padding="12,18,12,12"
                                 HorizontalOptions="Center">

                <!-- Robot face placeholder -->
                <Border Style="{StaticResource CardBorder}"
                        HorizontalOptions="Center"
                        WidthRequest="220"
                        HeightRequest="220"
                        Padding="20">
                    <VerticalStackLayout HorizontalOptions="Center"
                                        VerticalOptions="Center">
                        <Image Source="robot_reception.png"
                               WidthRequest="120"
                               HeightRequest="120"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        <!-- Listening indicator -->
                        <ActivityIndicator IsRunning="{Binding IsListening}"
                                           IsVisible="{Binding IsListening}"
                                           Color="{StaticResource PrimaryDarkBlue}"
                                           WidthRequest="32"
                                           HeightRequest="32"
                                           HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Prompt / response text -->
                <c:PromptLabel Text="{Binding PromptText}"
                               HorizontalOptions="FillAndExpand" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Mic button -->
        <Border Grid.Row="2"
                HorizontalOptions="Center"
                Margin="0,4,0,16"
                WidthRequest="84"
                HeightRequest="84"
                StrokeShape="RoundRectangle 42"
                Stroke="Transparent">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleMicCommand}" />
            </Border.GestureRecognizers>
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding IsListening}"
                             Value="True">
                    <Setter Property="BackgroundColor" Value="{StaticResource DangerRed}" />
                </DataTrigger>
                <DataTrigger TargetType="Border"
                             Binding="{Binding IsListening}"
                             Value="False">
                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryDarkBlue}" />
                </DataTrigger>
            </Border.Triggers>
            <Border.Shadow>
                <Shadow Brush="#33000000" Offset="0,6" Radius="12" Opacity="0.4" />
            </Border.Shadow>
            <Label FontFamily="RobotoBold"
                   FontSize="{StaticResource FontSizeDisplay}"
                   TextColor="{StaticResource TextOnPrimary}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsListening}"
                                 Value="True">
                        <Setter Property="Text" Value="&#xE769;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                    </DataTrigger>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsListening}"
                                 Value="False">
                        <Setter Property="Text" Value="&#xE720;" />
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>
        </Border>

        <!-- Speaker toggle row -->
        <HorizontalStackLayout Grid.Row="3"
                               HorizontalOptions="Center"
                               Spacing="16"
                               Margin="0,0,0,24">
            <Label Text="&#xE15D;"
                   FontFamily="Segoe Fluent Icons"
                   FontSize="{StaticResource FontSizeTitleMedium}"
                   VerticalOptions="Center" />
            <Label Text="AIko is ready"
                   Style="{StaticResource SubtitleLabel}"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>
        </Grid>
    </Grid>
</controls:BaseContentPage>
