<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    x:Class="RobotHri.Views.MainPage"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Padding="12,8,12,12">

        <!-- Header -->
        <c:HeaderLayout Grid.Row="0"
                        x:Name="Header"
                        Title="{Binding TitleText}"
                        LanguageLabelText="{Binding LanguageLabel}"
                        ShowBackButton="False" />

        <!-- Welcome banner -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Margin="8,14,8,0">
            <Grid ColumnDefinitions="Auto,*"
                  Padding="6">
                <Image Grid.Column="0"
                       Source="robot_reception.png"
                       WidthRequest="34"
                       HeightRequest="34"
                       Margin="0,0,12,0"
                       VerticalOptions="Center"
                       Aspect="AspectFit" />
                <Label Grid.Column="1"
                       Text="{Binding WelcomeText}"
                       Style="{StaticResource SubtitleLabel}"
                       FontSize="{StaticResource FontSizeSubtitle}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Start" />
            </Grid>
        </Border>

        <!-- Navigation cards (1 × 2 to center the two remaining) -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              RowDefinitions="*"
              ColumnSpacing="16"
              Padding="8,14,8,0">

            <!-- Navigation -->
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateNaviCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="16"
                                     Padding="{StaticResource CardPadding}">
                    <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                            WidthRequest="92"
                            HeightRequest="92"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="46" />
                        </Border.StrokeShape>
                        <Image Source="icon_nav.png"
                               WidthRequest="54"
                               HeightRequest="54"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding BtnNavigation}"
                           Style="{StaticResource TitleLabel}"
                           FontSize="{StaticResource FontSizeTitleLarge}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Delivery -->
            <Border Grid.Column="1"
                    Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateDeliCommand}" />
                </Border.GestureRecognizers>
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="16"
                                     Padding="{StaticResource CardPadding}">
                    <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                            WidthRequest="92"
                            HeightRequest="92"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="46" />
                        </Border.StrokeShape>
                        <Label Text="📦"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Text="{Binding BtnDelivery}"
                           Style="{StaticResource TitleLabel}"
                           FontSize="{StaticResource FontSizeTitleLarge}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

        </Grid>

        <!-- Footer -->
        <VerticalStackLayout Grid.Row="3"
                             Padding="{StaticResource PagePadding}"
                             Spacing="10">
            <Label Text="Thái Dương Company •  AIko v2.0"
                   Style="{StaticResource SubtitleLabel}"
                   FontSize="{StaticResource FontSizeCaption}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</controls:BaseContentPage>
