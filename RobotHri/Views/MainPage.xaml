<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    x:Class="RobotHri.Views.MainPage"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="Auto,*">

        <c:NavRail Grid.Column="0"
                   VerticalOptions="Fill"
                   QnaCommand="{Binding NavigateQnaCommand}"
                   NaviCommand="{Binding NavigateNaviCommand}"
                   LabCommand="{Binding NavigateLabCommand}"
                   DeliCommand="{Binding NavigateDeliCommand}"
                   QnaLabel="{Binding BtnQna}"
                   NaviLabel="{Binding BtnNavigation}"
                   LabLabel="{Binding BtnLab}"
                   DeliLabel="{Binding BtnDelivery}" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              Padding="16,12,16,16">

            <Image Grid.RowSpan="3"
           Source="lotus_bg.png"
           Aspect="AspectFill"
           Opacity="0.98"
           InputTransparent="True" />

            <Image Grid.RowSpan="3"
                   Source="main_bg.png"
                   Aspect="AspectFill"
                   Opacity="0.9"
                   InputTransparent="True" />
            <BoxView Grid.RowSpan="3"
                     Color="#1A870002"
                     InputTransparent="True" />

            <Border Grid.Row="0"
            BackgroundColor="#E6870002"
            Stroke="#55FFFFFF"
            StrokeThickness="1"
            Margin="0,0,0,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <c:HeaderLayout x:Name="Header"
            Title="{Binding TitleText}"
            ShowBackButton="False"
            LanguageLabelText="{Binding LanguageLabel}" />
            </Border>

            <!-- Welcome card — tighter margin -->
            <Border Grid.Row="1"
                    BackgroundColor="#D9F8EDEA"
                    Stroke="#66870002"
                    StrokeThickness="1"
                    Padding="16,14"
                    Margin="8,0,8,8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,3" Radius="10" Opacity="0.2" />
                </Border.Shadow>
                <Grid ColumnDefinitions="72,*,64"
                      ColumnSpacing="14"
                      VerticalOptions="Center">
                    <Image Grid.Column="0"
                           Source="robot_reception.png"
                           WidthRequest="72"
                           HeightRequest="72"
                           Aspect="AspectFit"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="PromptLabel"
                           Text="{Binding WelcomeText}"
                           FontFamily="RobotoBold"
                           FontSize="{StaticResource FontSizeSubtitle}"
                           TextColor="{StaticResource WarmText}"
                           LineBreakMode="WordWrap"
                           MaxLines="3"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center" />
                    <Image Grid.Column="2"
                           Source="logo_fablab.png"
                           WidthRequest="64"
                           HeightRequest="64"
                           Aspect="AspectFit"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Actions: 2 tiles full width, icon on top, text below -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="300,300"
                  ColumnSpacing="16"
                  Margin="8,50,8,0"
                  VerticalOptions="Start"
                  HorizontalOptions="Center">

                <!-- Q&A tile -->
                <Border Grid.Column="0"
                        HorizontalOptions="Fill"
                        MinimumHeightRequest="160"
                        BackgroundColor="#E2F8EDE8"
                        Stroke="#75870002"
                        StrokeThickness="1"
                        Padding="16,20,16,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#28000000" Offset="0,5" Radius="12" Opacity="0.18" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateQnaCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HorizontalOptions="Center"
                                BackgroundColor="{StaticResource DestinationPastelPink}"
                                StrokeThickness="0"
                                WidthRequest="72"
                                HeightRequest="72">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="36" />
                            </Border.StrokeShape>
                            <Image Source="icon_mic.png"
                                   WidthRequest="42"
                                   HeightRequest="42"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding BtnQna}"
                               FontFamily="RobotoBold"
                               FontSize="{StaticResource FontSizeTitleMedium}"
                               TextColor="{StaticResource WarmText}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </VerticalStackLayout>
                </Border>

                <!-- Navigation tile -->
                <Border Grid.Column="1"
                        HorizontalOptions="Fill"
                        MinimumHeightRequest="160"
                        BackgroundColor="#E2F8EDE8"
                        Stroke="#75870002"
                        StrokeThickness="1"
                        Padding="16,20,16,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#28000000" Offset="0,5" Radius="12" Opacity="0.18" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateNaviCommand}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Border HorizontalOptions="Center"
                                BackgroundColor="{StaticResource DestinationPastelBlue}"
                                StrokeThickness="0"
                                WidthRequest="72"
                                HeightRequest="72">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="36" />
                            </Border.StrokeShape>
                            <Image Source="icon_nav.png"
                                   WidthRequest="42"
                                   HeightRequest="42"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding BtnNavigation}"
                               FontFamily="RobotoBold"
                               FontSize="{StaticResource FontSizeTitleMedium}"
                               TextColor="{StaticResource WarmText}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </Grid>
    </Grid>
</controls:BaseContentPage>
