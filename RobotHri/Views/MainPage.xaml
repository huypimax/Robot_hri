<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    x:Class="RobotHri.Views.MainPage"
    x:DataType="vm:MainViewModel"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="Auto,*">

        <!-- ── Navigation Rail (full-height left column) ── -->
        <c:NavRail Grid.Column="0"
                   VerticalOptions="Fill"
                   QnaCommand="{Binding NavigateQnaCommand}"
                   NaviCommand="{Binding NavigateNaviCommand}"
                   LabCommand="{Binding NavigateLabCommand}"
                   DeliCommand="{Binding NavigateDeliCommand}"
                   QnaLabel="{Binding BtnQna}"
                   NaviLabel="{Binding BtnNavigation}"
                   LabLabel="{Binding BtnLab}"
                   DeliLabel="{Binding BtnDelivery}" />
        <!-- ── Right side: Header  +  Content  +  Footer ── -->
        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*,Auto"
              Padding="12,8,12,12">

            <!-- Header (back button hidden — NavRail takes that role) -->
            <c:HeaderLayout Grid.Row="0"
                            x:Name="Header"
                            Title="{Binding TitleText}"
                            LanguageLabelText="{Binding LanguageLabel}"
                            ShowBackButton="False" />

            <!-- Welcome banner -->
            <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="18"
                Margin="0,8,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="18">
                    <Image Grid.Column="0"
                    Source="robot_reception.png"
                    WidthRequest="96"
                    HeightRequest="96"
                    Aspect="AspectFit"
                    VerticalOptions="Center" />

                    <Label Grid.Column="1"
                    x:Name="PromptLabel"
                    Text="{Binding WelcomeText}"
                    Style="{StaticResource SubtitleLabel}"
                    FontSize="{StaticResource FontSizeTitleLarge}"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center" />
                    <Image Grid.Column="2"
                    Source="logo_fablab.png"
                    WidthRequest="76"
                    HeightRequest="76"
                    Aspect="AspectFit"
                    VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Navigation cards (2 × 2) -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  RowDefinitions="*,*"
                  ColumnSpacing="8"
                  RowSpacing="8"
                  Padding="0,8,0,0">

                <!-- Q&A -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateQnaCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="16"
                        Padding="{StaticResource CardPadding}">
                        <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                                WidthRequest="92"
                                HeightRequest="92"
                                StrokeThickness="0">    
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="46" />
                        </Border.StrokeShape>
                        <Image Source="icon_mic.png"
                            WidthRequest="54"
                            HeightRequest="54"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />     
                        </Border>
                        <Label Text="{Binding BtnQna}"
                        Style="{StaticResource TitleLabel}"
                        FontSize="{StaticResource FontSizeTitleLarge}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Navigation -->
                <Border Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateNaviCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="16"
                                     Padding="{StaticResource CardPadding}">
                        <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                            WidthRequest="92"
                            HeightRequest="92"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="46" />
                            </Border.StrokeShape>
                            <Image Source="icon_nav.png"
                               WidthRequest="54"
                               HeightRequest="54"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding BtnNavigation}"
                           Style="{StaticResource TitleLabel}"
                           FontSize="{StaticResource FontSizeTitleLarge}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Lab -->
                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateLabCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Spacing="16"
                        Padding="{StaticResource CardPadding}">
                        <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                            WidthRequest="92"
                            HeightRequest="92"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="46" />
                                </Border.StrokeShape>
                            <Image Source="icon_nav.png"
                                WidthRequest="54"
                                HeightRequest="54"
                                Aspect="AspectFit"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" /> 
                        </Border>
                        <Label Text="{Binding BtnLab}"
                            Style="{StaticResource TitleLabel}"
                            FontSize="{StaticResource FontSizeTitleLarge}"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Delivery -->
                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateDeliCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="16"
                                     Padding="{StaticResource CardPadding}">
                        <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                            WidthRequest="92"
                            HeightRequest="92"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="46" />
                            </Border.StrokeShape>
                            <Label Text="📦"
                               FontSize="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        </Border>
                        <Label Text="{Binding BtnDelivery}"
                           Style="{StaticResource TitleLabel}"
                           FontSize="{StaticResource FontSizeTitleLarge}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</controls:BaseContentPage>
