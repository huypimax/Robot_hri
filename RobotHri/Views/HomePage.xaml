<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    x:Class="RobotHri.Views.HomePage"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="Auto,*">
        <c:NavRail Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*,Auto"
              Padding="12,8,12,12">

        <Grid Grid.RowSpan="4"
              InputTransparent="True"
              ZIndex="-1">
            <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                    WidthRequest="110"
                    HeightRequest="110"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    TranslationX="-20"
                    TranslationY="-28"
                    Opacity="0.38"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="55" />
                </Border.StrokeShape>
            </Border>
            <Border BackgroundColor="{StaticResource LightBlue}"
                    WidthRequest="90"
                    HeightRequest="90"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    TranslationX="18"
                    TranslationY="24"
                    Opacity="0.35"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="45" />
                </Border.StrokeShape>
            </Border>
        </Grid>

        <c:HeaderLayout Grid.Row="0"
                        x:Name="Header"
                        ShowBackButton="False" />

        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="18"
                Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="18">
                <Image Grid.Column="0"
                       Source="robot_reception.png"
                       WidthRequest="96"
                       HeightRequest="96"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       x:Name="PromptLabel"
                       Text="Do you need me to transport the goods for you?"
                       Style="{StaticResource TitleLabel}"
                       FontSize="{StaticResource FontSizeTitleMedium}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Image Grid.Column="2"
                       Source="logo_fablab.png"
                       WidthRequest="76"
                       HeightRequest="76"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,*"
              ColumnSpacing="24"
              HorizontalOptions="Center"
              Margin="0,26,0,0">
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}"
                    WidthRequest="150"
                    HeightRequest="150"
                    Padding="12">
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="&#xE73E;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="32"
                           TextColor="{StaticResource PrimaryDarkBlue}"
                           HorizontalOptions="Center" />
                    <Button Text="YES"
                            x:Name="YesButton"
                            Clicked="OnYesClicked"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="112" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorder}"
                    WidthRequest="150"
                    HeightRequest="150"
                    Padding="12">
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="&#xE711;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="32"
                           TextColor="{StaticResource DangerRed}"
                           HorizontalOptions="Center" />
                    <Button Text="NO, THANK YOU!"
                            x:Name="NoButton"
                            Clicked="OnNoClicked"
                            Style="{StaticResource SoftButton}"
                            WidthRequest="118"
                            LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</controls:BaseContentPage>
