<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    x:Class="RobotHri.Views.HomePage"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto"
          Padding="24,28">

        <Grid>
            <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                    WidthRequest="180"
                    HeightRequest="180"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    TranslationX="-60"
                    TranslationY="-70"
                    Opacity="0.55"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="90" />
                </Border.StrokeShape>
            </Border>
            <Border BackgroundColor="{StaticResource LightBlue}"
                    WidthRequest="120"
                    HeightRequest="120"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    TranslationX="36"
                    TranslationY="45"
                    Opacity="0.45"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="60" />
                </Border.StrokeShape>
            </Border>
        </Grid>

        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Padding="18"
                Margin="0,8,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="18">
                <Image Grid.Column="0"
                       Source="robot_reception.png"
                       WidthRequest="96"
                       HeightRequest="96"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Do you need me to transport the goods for you?"
                       Style="{StaticResource TitleLabel}"
                       FontSize="{StaticResource FontSizeTitleMedium}"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Image Grid.Column="2"
                       Source="logo_fablab.png"
                       WidthRequest="76"
                       HeightRequest="76"
                       Aspect="AspectFit"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              ColumnSpacing="24"
              HorizontalOptions="Center"
              Margin="0,26,0,0">
            <Border Grid.Column="0"
                    Style="{StaticResource CardBorder}"
                    WidthRequest="150"
                    HeightRequest="150"
                    Padding="12">
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="✔"
                           FontSize="36"
                           TextColor="{StaticResource PrimaryDarkBlue}"
                           HorizontalOptions="Center" />
                    <Button Text="YES"
                            Clicked="OnYesClicked"
                            Style="{StaticResource PrimaryButton}"
                            WidthRequest="112" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardBorder}"
                    WidthRequest="150"
                    HeightRequest="150"
                    Padding="12">
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Label Text="✖"
                           FontSize="36"
                           TextColor="{StaticResource DangerRed}"
                           HorizontalOptions="Center" />
                    <Button Text="NO, THANK YOU!"
                            Clicked="OnNoClicked"
                            Style="{StaticResource SoftButton}"
                            WidthRequest="118"
                            LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</controls:BaseContentPage>
