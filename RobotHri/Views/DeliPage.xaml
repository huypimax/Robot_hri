<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    x:Class="RobotHri.Views.DeliPage"
    x:DataType="vm:DeliViewModel"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="14,10,14,14">

        <!-- Header -->
        <c:HeaderLayout Grid.Row="0"
                        x:Name="Header"
                        Title="{Binding TitleText}"
                        BackText="{Binding HomeText}"
                        ShowBackButton="True"
                        LanguageLabelText="{Binding LanguageLabel}" />

        <!-- Prompt -->
        <c:PromptLabel Grid.Row="1"
                       Text="{Binding PromptText}"
                       Margin="4,12,4,0" />

        <!-- Delivery form -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="4,14,4,4" Spacing="12">

                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                                WidthRequest="44"
                                HeightRequest="44"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Label Text="📦"
                                   FontSize="24"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding FormTitle}"
                                   Style="{StaticResource TitleLabel}"
                                   FontSize="{StaticResource FontSizeTitleMedium}" />
                            <Label Text="Fill all details before starting delivery."
                                   Style="{StaticResource SubtitleLabel}"
                                   FontSize="{StaticResource FontSizeBody}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}"
                        Padding="16"
                        Margin="0,2,0,8">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Destination"
                               Style="{StaticResource TitleLabel}"
                               FontSize="{StaticResource FontSizeBody}" />
                        <Border Style="{StaticResource FormFieldBorder}"
                                IsEnabled="{Binding IsFormEnabled}">
                            <Picker Title="{Binding ChooseDestinationText}"
                                    ItemsSource="{Binding Destinations}"
                                    SelectedItem="{Binding SelectedDestinationItem}"
                                    Style="{StaticResource FormPicker}" />
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding ItemLabel}"
                                       Style="{StaticResource SubtitleLabel}" />
                                <Border Style="{StaticResource FormFieldBorder}"
                                        IsEnabled="{Binding IsFormEnabled}">
                                    <Entry Text="{Binding Item}"
                                           Style="{StaticResource FormEntry}"
                                           Placeholder="Package name" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding NoteLabel}"
                                       Style="{StaticResource SubtitleLabel}" />
                                <Border Style="{StaticResource FormFieldBorder}"
                                        IsEnabled="{Binding IsFormEnabled}">
                                    <Entry Text="{Binding Note}"
                                           Style="{StaticResource FormEntry}"
                                           Placeholder="Optional note" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{Binding SenderLabel}"
                                       Style="{StaticResource SubtitleLabel}" />
                                <Border Style="{StaticResource FormFieldBorder}"
                                        IsEnabled="{Binding IsFormEnabled}">
                                    <Entry Text="{Binding SenderName}"
                                           Style="{StaticResource FormEntry}"
                                           Placeholder="Sender name" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding ReceiverLabel}"
                                       Style="{StaticResource SubtitleLabel}" />
                                <Border Style="{StaticResource FormFieldBorder}"
                                        IsEnabled="{Binding IsFormEnabled}">
                                    <Entry Text="{Binding ReceiverName}"
                                           Style="{StaticResource FormEntry}"
                                           Placeholder="Receiver name" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource LightBlue}" Margin="0,6,0,2" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <c:RobotButton Grid.Column="0"
                                           Text="{Binding ReceivedText}"
                                           Command="{Binding ReceivedCommand}"
                                           ButtonStyle="Secondary"
                                           HeightRequest="52"
                                           IsVisible="{Binding IsDelivering}"
                                           HorizontalOptions="FillAndExpand"
                                           VerticalOptions="Center">
                                <c:RobotButton.Triggers>
                                    <DataTrigger TargetType="c:RobotButton"
                                                 Binding="{Binding IsDelivering}"
                                                 Value="True">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="c:RobotButton"
                                                 Binding="{Binding IsDelivering}"
                                                 Value="False">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </c:RobotButton.Triggers>
                            </c:RobotButton>

                            <c:RobotButton Grid.Column="1"
                                           Text="{Binding StartDeliveryText}"
                                           Command="{Binding StartDeliveryCommand}"
                                           ButtonStyle="Primary"
                                           HeightRequest="52"
                                           IsVisible="{Binding IsDelivering, Converter={x:Static vm:InverseBoolConverter.Instance}}"
                                           HorizontalOptions="FillAndExpand"
                                           VerticalOptions="Center">
                                <c:RobotButton.Triggers>
                                    <DataTrigger TargetType="c:RobotButton"
                                                 Binding="{Binding IsDelivering}"
                                                 Value="False">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="c:RobotButton"
                                                 Binding="{Binding IsDelivering}"
                                                 Value="True">
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </DataTrigger>
                                </c:RobotButton.Triggers>
                            </c:RobotButton>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</controls:BaseContentPage>
