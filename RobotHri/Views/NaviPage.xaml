<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    xmlns:models="clr-namespace:RobotHri.Models"
    x:Class="RobotHri.Views.NaviPage"
    x:DataType="vm:NaviViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <vm:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="Auto,*">
        <c:NavRail Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              Padding="12,8,12,10">

        <!-- Decorative background -->
        <Grid Grid.RowSpan="3" InputTransparent="True">
            <Border BackgroundColor="{StaticResource PrimaryDarkBlueSoft}"
                    WidthRequest="110"
                    HeightRequest="110"
                    HorizontalOptions="End"
                    VerticalOptions="Start"
                    TranslationX="-18"
                    TranslationY="-24"
                    Opacity="0.36"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="55" />
                </Border.StrokeShape>
            </Border>
            <Border BackgroundColor="{StaticResource LightBlue}"
                    WidthRequest="86"
                    HeightRequest="86"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    TranslationX="14"
                    TranslationY="22"
                    Opacity="0.32"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="43" />
                </Border.StrokeShape>
            </Border>
        </Grid>

        <!-- Header -->
        <c:HeaderLayout Grid.Row="0"
                        x:Name="Header"
                        Title="{Binding TitleText}"
                        BackText="{Binding HomeText}"
                        ShowBackButton="True"
                        LanguageLabelText="{Binding LanguageLabel}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />

        <!-- Prompt bar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Padding="14,10"
                Margin="8,12,8,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="&#xE707;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="{StaticResource FontSizeTitleMedium}"
                       VerticalOptions="Center"
                       TextColor="{StaticResource PrimaryDarkBlue}" />
                <Label Grid.Column="1"
                       Text="{Binding PromptText}"
                       Style="{StaticResource TitleLabel}"
                       FontSize="{StaticResource FontSizeTitleMedium}"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Room buttons grid -->
        <ScrollView Grid.Row="2" Margin="0,10,0,0">
            <Border Style="{StaticResource CardBorder}"
                    Margin="8,0"
                    Padding="12,14">
                <FlexLayout BindableLayout.ItemsSource="{Binding AvailableRooms}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="SpaceBetween"
                            AlignItems="Start"
                            AlignContent="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:RoomButtonData">
                            <c:NavRoomButton RoomName="{Binding RoomName}"
                                             RoomKey="{Binding RoomKey}"
                                             IsActive="{Binding Source={RelativeSource AncestorType={x:Type vm:NaviViewModel}}, Path=ActiveRoomKey, Converter={x:Static vm:EqualityConverter.Instance}, ConverterParameter={Binding RoomKey}}"
                                             RoomSelected="OnRoomSelected"
                                             IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type vm:NaviViewModel}}, Path=IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                             Margin="0,0,0,12"
                                             FlexLayout.Basis="31.5%" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </Border>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              ZIndex="100">
            <c:LoadingPopupView BindingContext="{Binding .}" />
        </Grid>

        <!-- Notification Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsNotificationPopupVisible}"
              BackgroundColor="#80000000"
              ZIndex="101">
            <c:NotificationPopupView BindingContext="{Binding .}" />
        </Grid>

        <!-- Error Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsErrorPopupVisible}"
              BackgroundColor="#80000000"
              ZIndex="102">
            <c:ErrorPopupView BindingContext="{Binding .}" />
        </Grid>
        </Grid>
    </Grid>
</controls:BaseContentPage>
