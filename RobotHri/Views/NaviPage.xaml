<?xml version="1.0" encoding="utf-8" ?>
<controls:BaseContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:RobotHri.Controls.Base"
    xmlns:c="clr-namespace:RobotHri.Controls"
    xmlns:vm="clr-namespace:RobotHri.ViewModels"
    xmlns:models="clr-namespace:RobotHri.Models"
    x:Class="RobotHri.Views.NaviPage"
    x:DataType="vm:NaviViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <vm:InverseBooleanConverter x:Key="InverseBooleanConverter" />
    </ContentPage.Resources>

    <Grid ColumnDefinitions="Auto,*">
        <c:NavRail Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              Padding="12,8,12,10">

        <Image Grid.RowSpan="3"
               Source="lotus_bg.png"
               Aspect="AspectFill"
               Opacity="0.3"
               InputTransparent="True" />

        <Image Grid.Row="0"
               Source="lotus_banner.png"
               HeightRequest="78"
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Start"
               Margin="0,0,0,6"
               InputTransparent="True" />

        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="{StaticResource NavGlassDark}"
                StrokeThickness="0"
                Margin="0,0,0,4">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <c:HeaderLayout x:Name="Header"
                            Title="{Binding TitleText}"
                            BackText="{Binding HomeText}"
                            ShowBackButton="True"
                            LanguageLabelText="{Binding LanguageLabel}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
        </Border>

        <!-- Prompt bar -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                BackgroundColor="{StaticResource NavGlassLight}"
                Stroke="#55FFFFFF"
                Padding="14,10"
                Margin="8,12,8,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="&#xE707;"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="{StaticResource FontSizeTitleMedium}"
                       VerticalOptions="Center"
                       TextColor="{StaticResource PrimaryDarkBlue}" />
                <Label Grid.Column="1"
                       Text="{Binding PromptText}"
                       Style="{StaticResource TitleLabel}"
                       FontSize="{StaticResource FontSizeTitleMedium}"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Destinations: 3 columns × 3 rows -->
        <ScrollView Grid.Row="2"
                    Margin="0,8,0,4"
                    IsClippedToBounds="False">
            <Border Style="{StaticResource CardBorder}"
                    BackgroundColor="#42F8EDEE"
                    Stroke="#55870002"
                    Margin="8,0"
                    Padding="10,12">
                <CollectionView ItemsSource="{Binding AvailableRooms}"
                                SelectionMode="None"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="3"
                                         HorizontalItemSpacing="8"
                                         VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RoomButtonData">
                            <Grid Padding="0,0,0,0">
                                <c:NavRoomButton RoomName="{Binding RoomName}"
                                                 RoomKey="{Binding RoomKey}"
                                                 HorizontalOptions="Fill"
                                                 VerticalOptions="Fill"
                                                 IsActive="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ActiveRoomKey, Converter={x:Static vm:EqualityConverter.Instance}, ConverterParameter={Binding RoomKey}}"
                                                 RoomSelected="OnRoomSelected"
                                                 IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                                 Margin="0,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000"
              ZIndex="100">
            <c:LoadingPopupView BindingContext="{Binding .}" />
        </Grid>

        <!-- Notification Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsNotificationPopupVisible}"
              BackgroundColor="#80000000"
              ZIndex="101">
            <c:NotificationPopupView BindingContext="{Binding .}" />
        </Grid>

        <!-- Error Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsErrorPopupVisible}"
              BackgroundColor="#80000000"
              ZIndex="102">
            <c:ErrorPopupView BindingContext="{Binding .}" />
        </Grid>
        </Grid>
    </Grid>
</controls:BaseContentPage>
