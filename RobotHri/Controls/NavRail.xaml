<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotHri.Controls.NavRail">

    <Border BackgroundColor="{StaticResource PrimaryDarkBlue}"
            Stroke="#22FFFFFF"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,18,18,0"
            Shadow="{Shadow Brush=#22000000, Offset='2,0', Radius=8, Opacity=0.35}">
        <Grid x:Name="RailContainer"
          BackgroundColor="Transparent"
          WidthRequest="{StaticResource NavRailCollapsedWidth}"
          VerticalOptions="Fill"
          IsClippedToBounds="True">

        <VerticalStackLayout Spacing="0" VerticalOptions="Start">

            <!-- Menu toggle -->
            <Border HeightRequest="{StaticResource HeaderHeight}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="{StaticResource NavRailItemPadding}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="MenuTap" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource NavRailItemSpacing}"
                                       VerticalOptions="Center">
                    <Label Text="&#xE700;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="{StaticResource FontSizeTitleLarge}"
                           TextColor="{StaticResource TextOnPrimary}"
                           WidthRequest="{StaticResource NavRailIconWidth}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="MenuText"
                           TextColor="{StaticResource TextOnPrimary}"
                           FontFamily="RobotoBold"
                           FontSize="{StaticResource FontSizeHeaderTitle}"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </HorizontalStackLayout>
            </Border>

            <!-- Divider -->
            <BoxView HeightRequest="1"
                     Color="{StaticResource BorderLight}"
                     Margin="{StaticResource HeaderButtonPadding}" />

            <!-- Home -->
            <Border HeightRequest="{StaticResource NavRailItemHeight}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="{StaticResource NavRailItemPadding}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="HomeTap" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource NavRailItemSpacing}"
                                       VerticalOptions="Center">
                    <Label Text="&#xE80F;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="{StaticResource NavRailIconSize}"
                           WidthRequest="{StaticResource NavRailIconWidth}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="HomeText"
                           TextColor="{StaticResource TextOnPrimary}"
                           FontFamily="RobotoRegular"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </HorizontalStackLayout>
            </Border>

            <!-- Main -->
            <Border HeightRequest="{StaticResource NavRailItemHeight}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="{StaticResource NavRailItemPadding}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="MainTap" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource NavRailItemSpacing}"
                                       VerticalOptions="Center">
                    <Label Text="&#xE71D;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="{StaticResource NavRailIconSize}"
                           WidthRequest="{StaticResource NavRailIconWidth}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="MainPageText"
                           TextColor="{StaticResource TextOnPrimary}"
                           FontFamily="RobotoRegular"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </HorizontalStackLayout>
            </Border>

            <!-- Navigation -->
            <Border HeightRequest="{StaticResource NavRailItemHeight}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="{StaticResource NavRailItemPadding}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="NaviTap" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource NavRailItemSpacing}"
                                       VerticalOptions="Center">
                    <Label Text="&#xE707;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="{StaticResource NavRailIconSize}"
                           WidthRequest="{StaticResource NavRailIconWidth}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="NaviText"
                           TextColor="{StaticResource TextOnPrimary}"
                           FontFamily="RobotoRegular"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </HorizontalStackLayout>
            </Border>

            <!-- Delivery -->
            <Border HeightRequest="{StaticResource NavRailItemHeight}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="{StaticResource NavRailItemPadding}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="DeliTap" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource NavRailItemSpacing}"
                                       VerticalOptions="Center">
                    <Label Text="&#xE7BF;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="{StaticResource NavRailIconSize}"
                           WidthRequest="{StaticResource NavRailIconWidth}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="DeliText"
                           TextColor="{StaticResource TextOnPrimary}"
                           FontFamily="RobotoRegular"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </HorizontalStackLayout>
            </Border>

            <!-- Setup -->
            <Border HeightRequest="{StaticResource NavRailItemHeight}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    Padding="{StaticResource NavRailItemPadding}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer x:Name="SetupTap" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="{StaticResource NavRailItemSpacing}"
                                       VerticalOptions="Center">
                    <Label Text="&#xE713;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="{StaticResource NavRailIconSize}"
                           WidthRequest="{StaticResource NavRailIconWidth}"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center" />
                    <Label x:Name="SetupText"
                           TextColor="{StaticResource TextOnPrimary}"
                           FontFamily="RobotoRegular"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalOptions="Center"
                           IsVisible="False" />
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
