<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotHri.Controls.NavRoomButton">

    <Border x:Name="RoomBorder"
            BackgroundColor="{StaticResource DestinationPastelPink}"
            Stroke="#668D8D8D"
            StrokeThickness="1"
            Padding="12,14,12,14"
            MinimumHeightRequest="{StaticResource NavRoomMinHeight}"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}" />
        </Border.StrokeShape>

        <Border.Shadow>
            <Shadow Brush="{StaticResource CardShadowBrush}"
                    Offset="0,3"
                    Radius="{StaticResource NavRoomShadowRadius}"
                    Opacity="{StaticResource NavRoomShadowOpacity}" />
        </Border.Shadow>

        <Border.GestureRecognizers>
            <TapGestureRecognizer x:Name="RoomTap" />
        </Border.GestureRecognizers>

        <VerticalStackLayout HorizontalOptions="Fill"
                             VerticalOptions="Center"
                             Spacing="{StaticResource SmallSpacing}">
            <Image x:Name="RoomIcon"
                   HeightRequest="{StaticResource NavRoomImageSize}"
                   WidthRequest="{StaticResource NavRoomImageSize}"
                   HorizontalOptions="Center"
                   IsVisible="False" />
            <Label x:Name="RoomLabel"
                   HorizontalOptions="Fill"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   MaxLines="2"
                   TextColor="{StaticResource WarmText}"
                   FontFamily="RobotoBold"
                   FontSize="{StaticResource FontSizeRoomLabel}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
