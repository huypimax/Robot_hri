<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotHri.Controls.RobotButton">

    <Border x:Name="ButtonBorder"
            BackgroundColor="{StaticResource PrimaryDarkBlue}"
            StrokeShape="RoundRectangle 18"
            Stroke="Transparent"
            Padding="0"
            MinimumWidthRequest="{StaticResource ButtonMinWidth}"
            MinimumHeightRequest="{StaticResource ButtonMinHeight}">


        <Border.Shadow>
            <Shadow Brush="#2A000000"
                    Offset="0,6"
                    Radius="10"
                    Opacity="0.34" />
        </Border.Shadow>

        <Grid>
            <!-- Icon (optional) -->
            <Image x:Name="ButtonIcon"
                   HorizontalOptions="Start"
                   VerticalOptions="Center"
                   Margin="14,0,0,0"
                   WidthRequest="24"
                   HeightRequest="24"
                   IsVisible="False" />

            <!-- Label -->
            <Label x:Name="ButtonLabel"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   TextColor="{StaticResource White}"
                   FontFamily="RobotoBold"
                   FontSize="{StaticResource FontSizeButton}"
                   HorizontalTextAlignment="Center"
                   Padding="14,0" />
        </Grid>
    </Border>
</ContentView>
