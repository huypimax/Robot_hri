<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RobotHri.Controls.HeaderLayout">

    <Grid BackgroundColor="{StaticResource WarmText}"
          HeightRequest="{StaticResource HeaderHeight}"
          Padding="{StaticResource HeaderPadding}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>

        <!-- Back / Home button (left) -->
        <Border x:Name="BackButton"
                Grid.Column="0"
                BackgroundColor="Transparent"
                Stroke="Transparent"
                Padding="{StaticResource HeaderButtonPadding}"
                IsVisible="False"
                VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="{StaticResource HeaderButtonCornerRadius}" />
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="BackTap" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="{StaticResource SmallSpacing}">
                <Label Text="&#xE72B;"
                       FontFamily="Segoe Fluent Icons"
                       TextColor="{StaticResource TextOnPrimary}"
                       FontSize="{StaticResource FontSizeTitleLarge}"
                       VerticalOptions="Center" />
                <Label x:Name="BackLabel"
                       TextColor="{StaticResource TextOnPrimary}"
                       FontFamily="RobotoRegular"
                       FontSize="{StaticResource FontSizeBody}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Title (center) -->
        <Label x:Name="TitleLabel"
               Grid.Column="1"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="{StaticResource TextOnPrimary}"
               FontFamily="RobotoBold"
               FontSize="{StaticResource FontSizeHeaderTitle}"
               HorizontalTextAlignment="Center" />

        <!-- Battery (%) -->
        <Border x:Name="BatteryBadge"
                Grid.Column="2"
                BackgroundColor="{StaticResource OverlayLight}"
                Padding="12,6"
                Margin="0,0,8,0"
                VerticalOptions="Center">
            <Border.Stroke>
                <SolidColorBrush Color="#33FFFFFF" />
            </Border.Stroke>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="🔋"
                       FontSize="{StaticResource FontSizeLanguage}"
                       VerticalOptions="Center" />
                <Label x:Name="BatteryLabel"
                       Text="—"
                       TextColor="{StaticResource TextOnPrimary}"
                       FontFamily="RobotoBold"
                       FontSize="{StaticResource FontSizeLanguage}"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Language button (right) -->
        <Border x:Name="LanguageButton"
                Grid.Column="3"
                BackgroundColor="{StaticResource OverlayLight}"
                Padding="12,6"
                VerticalOptions="Center">
            <Border.Stroke>
                <SolidColorBrush Color="#33FFFFFF" />
            </Border.Stroke>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="5" />
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <TapGestureRecognizer x:Name="LanguageTap" />
            </Border.GestureRecognizers>
            <Label x:Name="LanguageLabel"
                   TextColor="{StaticResource TextOnPrimary}"
                   FontFamily="RobotoBold"
                   FontSize="{StaticResource FontSizeLanguage}"
                   HorizontalOptions="Center"/>
        </Border>
    </Grid>
</ContentView>
