<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ======== Brand Colors (from src/utilities/colors.py) ======== -->
    <Color x:Key="PrimaryDarkBlue">#870002</Color>
    <Color x:Key="LightBlue">#FAD8D8</Color>
    <Color x:Key="HoverBg">#FFF1F1</Color>
    <Color x:Key="PageBackground">#F5EFDF</Color>
    <Color x:Key="PrimaryDarkBlueSoft">#FBEAEA</Color>
    <Color x:Key="PageBackgroundTop">#FFF9F2</Color>
    <Color x:Key="PageBackgroundBottom">#F5EFDF</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="SuccessGreen">#2ECC71</Color>
    <Color x:Key="DangerRed">#AC0000</Color>
    <Color x:Key="AccentGreen">#69FF3D</Color>
    <Color x:Key="WarmText">#870002</Color>
    <Color x:Key="WarmCream">#F5EFDF</Color>
    <Color x:Key="NavGlassDark">#96000000</Color>
    <Color x:Key="NavGlassLight">#1F000000</Color>
    <Color x:Key="DestinationPastelPink">#C8FFD9F7</Color>
    <Color x:Key="DestinationPastelBlue">#C8C0FAFF</Color>
    <Color x:Key="DestinationPastelPeach">#C8FFD3C5</Color>

    <!-- ======== Text Colors ======== -->
    <Color x:Key="TextDark">#870002</Color>
    <Color x:Key="TextMuted">#7F5A5A</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextColor">#1F2A37</Color>

    <!-- ======== Shadow / Overlay ======== -->
    <Color x:Key="ShadowColor">#40000000</Color>
    <Color x:Key="OverlayLight">#1AFFFFFF</Color>
    <Color x:Key="BorderLight">#40FFFFFF</Color>
    <Color x:Key="CardBorderColor">#33870002</Color>

    <!-- Brushes for shadows and borders -->
    <SolidColorBrush x:Key="CardShadowBrush" Color="#1F870002" />
    <SolidColorBrush x:Key="ButtonShadowBrush" Color="#33870002" />
    <SolidColorBrush x:Key="OverlayLightBrush" Color="{StaticResource OverlayLight}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <LinearGradientBrush x:Key="AppPageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PageBackgroundTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PageBackground}" Offset="0.45" />
        <GradientStop Color="{StaticResource PageBackgroundBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Time-settings tab accent colors -->
    <Color x:Key="TimeTabWaitingColor">#F0A800</Color>
    <Color x:Key="TimeTabCustomColor">#00A896</Color>

    <!-- Semantic aliases -->
    <Color x:Key="Primary">#870002</Color>
    <Color x:Key="Secondary">#FAD8D8</Color>
    <Color x:Key="Tertiary">#FFF1F1</Color>
</ResourceDictionary>
