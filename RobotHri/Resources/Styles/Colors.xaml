<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ======== Brand Colors ======== -->
    <!-- Industrial two-color scheme: orange + navy -->
    <Color x:Key="PrimaryDarkBlue">#00294D</Color>
    <!-- Header bar background (HeaderLayout and related chrome; matches Shell nav styling) -->
    <Color x:Key="WarmText">#00294D</Color>
    <Color x:Key="LightBlue">#D8E5FE</Color>
    <Color x:Key="HoverBg">#F0F6FF</Color>
    <Color x:Key="PageBackground">#EEF4FF</Color>
    <Color x:Key="PrimaryDarkBlueSoft">#EAF0F6</Color>
    <Color x:Key="LightBlue">#D4DEE8</Color>
    <Color x:Key="HoverBg">#EEF3F8</Color>
    <Color x:Key="PageBackground">#F5F7FA</Color>
    <Color x:Key="PageBackgroundTop">#FFFFFF</Color>
    <Color x:Key="PageBackgroundBottom">#EEF2F6</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="SuccessGreen">#2ECC71</Color>
    <Color x:Key="DangerRed">#AC0000</Color>
    <Color x:Key="AccentGreen">#69FF3D</Color>

    <!-- ======== Text Colors ======== -->
    <Color x:Key="TextDark">#1F2A37</Color>
    <Color x:Key="TextMuted">#5B6B7C</Color>
    <Color x:Key="TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="TextColor">#1F2A37</Color>

    <!-- ======== Shadow / Overlay ======== -->
    <Color x:Key="ShadowColor">#40000000</Color>
    <Color x:Key="OverlayLight">#1AFFFFFF</Color>
    <Color x:Key="BorderLight">#40FFFFFF</Color>
    <Color x:Key="CardBorderColor">#1F00294D</Color>

    <!-- Brushes for shadows and borders -->
    <SolidColorBrush x:Key="CardShadowBrush" Color="#1A00294D" />
    <SolidColorBrush x:Key="ButtonShadowBrush" Color="#3300294D" />
    <SolidColorBrush x:Key="OverlayLightBrush" Color="{StaticResource OverlayLight}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <LinearGradientBrush x:Key="AppPageBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource PageBackgroundTop}" Offset="0.0" />
        <GradientStop Color="{StaticResource PageBackground}" Offset="0.45" />
        <GradientStop Color="{StaticResource PageBackgroundBottom}" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Time-settings tab accent colors -->
    <Color x:Key="TimeTabWaitingColor">#F0A800</Color>
    <Color x:Key="TimeTabCustomColor">#00A896</Color>

    <!-- Semantic aliases -->
    <Color x:Key="Primary">#F37021</Color>
    <Color x:Key="Secondary">#00294D</Color>
    <Color x:Key="Tertiary">#EAF0F6</Color>
</ResourceDictionary>
